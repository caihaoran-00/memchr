# 主提取 provider，可选 qwen / deepseek
LLM_PROVIDER=qwen

# 向量检索和 rerank 目前建议继续使用 qwen
EMBEDDING_PROVIDER=qwen
RERANK_PROVIDER=qwen

# Provider keys
QWEN_API_KEY=your-qwen-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key

# 可选覆盖
# LLM_BASE_URL=
# LLM_MODEL=
# EXTRACTION_MODEL=
# EMBEDDING_MODEL=
# RERANK_MODEL=
# RERANK_API_URL=
