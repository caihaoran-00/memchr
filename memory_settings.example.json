{
  "data_dir": "./data",
  "db_name": "memory.db",
  "working_memory_size": 10,
  "max_episodes_per_user": 100,
  "episode_summary_max_length": 200,
  "conversation_turns_before_extraction": 5,
  "max_context_episodes": 5,
  "max_profile_tags": 20,
  "max_facts_per_user": 50,
  "max_context_facts": 5,
  "memory_decay_days": 30,
  "min_importance_threshold": 0.2,
  "access_count_weight": 0.3,
  "time_decay_weight": 0.7,
  "llm_provider": "qwen",
  "embedding_provider": "qwen",
  "rerank_provider": "qwen",
  "llm_model": "qwen-plus",
  "extraction_model": "qwen-plus",
  "embedding_model": "text-embedding-v4",
  "rerank_model": "qwen3-rerank",
  "enable_vector_search": true,
  "enable_rerank": true,
  "vector_dim": 1024,
  "similarity_threshold": 0.45,
  "max_retrieval_results": 5,
  "episode_retrieval_top_k": 10,
  "episode_rerank_top_n": 5,
  "provider_api_keys": {
    "qwen": "your-qwen-api-key",
    "deepseek": "your-deepseek-api-key"
  }
}
